# Server Configuration
BIND_ADDRESS=0.0.0.0:3000  # Internal container port (mapped to 5678 on host)

# File Upload Limits
MAX_UPLOAD_SIZE=524288000  # 500MB in bytes
MAX_FILES_PER_JOB=50

# Conversion Settings
MAX_CONCURRENT_JOBS=10
MAX_CONCURRENT_CONVERSIONS=4

# Job Management
JOB_TIMEOUT=3600  # 1 hour in seconds

# Storage
TEMP_DIR=/tmp/narayan

# Logging
RUST_LOG=info  # Options: trace, debug, info, warn, error
